# Copy to apps/web/.env.local

# Required: free project id from https://dashboard.reown.com (public; restrict allowed domains there)
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Optional: which brand preset to show (rahasya | naisho | sotto)
NEXT_PUBLIC_BRAND=rahasya

# Optional: Base RPC used by the browser for balance reads (defaults to the public mainnet.base.org)
NEXT_PUBLIC_BASE_RPC_URL=

# Optional, server-only: NEAR Intents partner key (partners.near-intents.org); without it 1Click adds a small fee
ONECLICK_API_KEY=

# Optional, server-only: app fee on swaps, in basis points (max 100), paid to a NEAR Intents account.
# 1Click keeps half of it (with no app fee it charges 0.2% itself), so 50 = 0.5% total, 0.25% to you.
# The docs (content/docs/protocol.md, "Fees") state the rate: keep them in sync.
ONECLICK_APP_FEE_BPS=0
ONECLICK_FEE_RECIPIENT=
