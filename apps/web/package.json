{
  "name": "@pay/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/gen-docs.mjs && npm run -s -w @pay/proxy bundle && cp ../../packages/proxy/dist/rahasya.mjs ../../packages/proxy/dist/rahasya.mjs.sha256 public/ && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.typecheck.json",
    "test": "node --conditions=react-server --test \"src/**/*.test.ts\"",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && node ../../scripts/audit/check-worker-csp.mjs .open-next/assets && opennextjs-cloudflare deploy",
    "docs:gen": "node scripts/gen-docs.mjs"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "wrangler": "^4.158.0"
  },
  "dependencies": {
    "@hot-labs/near-connect": "^0.12.0",
    "@pay/rail": "^0.1.0",
    "@phala/dcap-qvl": "0.7.1",
    "@reown/appkit": "^1.8.24",
    "@reown/appkit-adapter-solana": "^1.8.24",
    "@reown/appkit-adapter-wagmi": "^1.8.24",
    "@solana/spl-token": "^0.4.14",
    "@noble/curves": "^1.9.1",
    "@solana/web3.js": "^1.98.4",
    "@tanstack/react-query": "^5.107.1",
    "@upstash/redis": "^1.41.0",
    "buffer": "6.0.3",
    "next": "^16.4.5",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "viem": "^2.57.16",
    "wagmi": "^3.7.11"
  }
}
