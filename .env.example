# Only for the command-line mainnet scripts (npm run e2e). The website needs none of this.
# Copy to .env and use THROWAWAY wallets only. Never put a main wallet's key here.

# Base (EVM) private key, 0x + 64 hex. Receives USDC from 1Click and pays Venice via x402 (no ETH needed).
BASE_PRIVATE_KEY=

# Solana secret key: base58 (Phantom export) or JSON byte array (solana-keygen). Fund with ~$6 of SOL.
SOLANA_SECRET_KEY=

# Optional
# BASE_RPC_URL=https://mainnet.base.org
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# ONECLICK_API_KEY=
# SWAP_SLIPPAGE_BPS=100
# MAX_SWAP_USD=10
# MAX_TOPUP_USD=6
# KILL_SWITCH=0
