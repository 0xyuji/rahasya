{
  "name": "near-pay-anything",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "e2e": "node --env-file=.env packages/rail/scripts/e2e.ts",
    "proxy": "node packages/proxy/src/cli.ts",
    "verify:tee": "node packages/rail/scripts/verify-tee.ts",
    "quote:dry": "node packages/rail/scripts/dry-quote.ts",
    "dev": "npm run dev -w @pay/web",
    "build": "npm run build -w @pay/web",
    "audit:probe": "node scripts/audit/probe.ts",
    "audit:pack": "node scripts/audit/pack.ts",
    "audit:csp": "node scripts/audit/check-worker-csp.mjs apps/web/.open-next/assets"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
